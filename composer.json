{
    "name": "itkdev/bibbox-admin",
    "description": "Administrative control node for bibboxes",
    "license": [
        "GPL-2.0-or-later"
    ],
    "type": "project",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.7",
        "drupal/adminimal_theme": "^1.7",
        "drupal/core-composer-scaffold": "^10.4",
        "drupal/core-project-message": "^10.4",
        "drupal/core-recommended": "^10.4",
        "drupal/field_group": "^3.4",
        "drush/drush": "^13"
    },
    "require-dev": {
        "drupal/coder": "^9.0",
        "ergebnis/composer-normalize": "^2.56",
        "mikey179/vfsstream": "^1.2",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        }
    }
}
